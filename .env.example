# Database (Neon, Supabase, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/benchmark?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Claude API (used for resume parsing / keyword extraction)
ANTHROPIC_API_KEY="sk-ant-..."

# File storage (S3-compatible: AWS S3 or Cloudflare R2)
S3_BUCKET_NAME="benchmark-resumes"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="" # only needed for R2 / non-AWS S3-compatible storage
